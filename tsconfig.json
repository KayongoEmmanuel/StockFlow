{
  "compilerOptions": {
    /* Environment & Language */
    "target": "es2022",
    "module": "es2022",
    "lib": ["es2022"],
    "moduleResolution": "bundler",
    "allowJs": true,

    /* Output */
    "outDir": "./dist",
    "rootDir": "./src",
    /* Strictness & Safety */
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["jest","node"]
  },
  "include": ["src/**/*"]
}
